FROM debian:bookworm-slim

# NOTE: Agentic verification requires the Kiro CLI (`kiro-cli`), which is not
# installed here. Install and authenticate it inside the container if needed.

RUN apt-get update \
 && apt-get install -y git curl \
 && curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /app
RUN git config --global --add safe.directory /app
